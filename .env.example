MLOPS_ROOT=.
MLOPS_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLOPS_EXPERIMENT_NAME=mlops-assignment-03
MLOPS_AIRFLOW_BASE_URL=http://127.0.0.1:8080
MLOPS_AIRFLOW_USERNAME=admin
# Set password or an Airflow 3 bearer token securely in the runtime.
MLOPS_AIRFLOW_PASSWORD=
MLOPS_AIRFLOW_TOKEN=
MLOPS_NAMESPACE=mlops
MLOPS_APPROVED_DAG_ID=mlops_training
MLOPS_PLANNER=offline
MLOPS_LLM_MODEL=gpt-4.1-mini
# For planner=openai, supply OPENAI_API_KEY securely; never commit it.
# API requires a bearer token for all chat requests, even offline planning.
MLOPS_API_TOKEN=
